<?xml version="1.0" encoding="utf-8"?>
<!--
  自社 Naranja.Platform.* は ../PlatformPackages（Platform で NugetPack.ps1 後に配置）。
  パック未配置だと PackageReference の復元に失敗する。
  グローバル NuGet.Config（%AppData%\NuGet\NuGet.config）には nuget.org のみ置き、
  PlatformPackages は各リポジトリの NuGet.config で <clear /> のうえ明示する（案A）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="PlatformPackages" value="../PlatformPackages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
