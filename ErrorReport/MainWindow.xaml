<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Naranja.ErrorReport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Naranja.ErrorReport.Models"
    mc:Ignorable="d"
    Title="エラー報告">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootPanel" Padding="16,12,16,16" RowSpacing="6" Loaded="RootPanel_Loaded"
          AllowDrop="True" DragOver="RootPanel_DragOver" Drop="RootPanel_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: 情報バー -->
        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="0"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Success"
                 Margin="0,0,0,6" />

        <!-- Row 1: 報告種別 + 送信先スタッフ (1行) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <RadioButton x:Name="ErrorReportRadio" Content="エラー報告"
                         GroupName="ReportMode" IsChecked="True" MinWidth="0" Padding="6,4" />
            <RadioButton x:Name="ScreenshotRadio" Content="スクリーンショット送付 To:"
                         GroupName="ReportMode" MinWidth="0" Padding="6,4"
                         Checked="ScreenshotRadio_Checked"
                         Unchecked="ScreenshotRadio_Unchecked" />
            <ComboBox x:Name="StaffCombo"
                      DisplayMemberPath="ShortName" SelectedValuePath="Id"
                      IsEnabled="False" MinWidth="120" VerticalAlignment="Center"
                      MaxDropDownHeight="800" />
        </StackPanel>

        <!-- Row 2: 件名 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Subject:" VerticalAlignment="Center" />
            <TextBox x:Name="SubjectText" Grid.Column="1" Text="エラー報告" />
        </Grid>

        <!-- Row 3: オーダーID + ヒント -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OrderIdLabel" Text="オーダーID:" VerticalAlignment="Center" />
            <TextBox x:Name="OrderIdText" Grid.Column="1"
                     TextChanged="OrderIdText_TextChanged" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.5" FontSize="11"
                       Text="開いているオーダー(発注)があれば自動入力。特定オーダー(発注)のエラー時は手動入力。※発注IDはマイナスで記入"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Row 4: 文章ラベル -->
        <TextBlock Grid.Row="4" Text="文章 (エラー報告時はエラーの状況＋再現方法を記入)" Opacity="0.7" />

        <!-- Row 5: 画像添付 -->
        <StackPanel Grid.Row="5" Spacing="4">
            <TextBlock Opacity="0.5" FontSize="11"
                       Text="Ctrl+V で画像を添付（最大20枚）。未添付のときは送信時に全画面をキャプチャします。" />
            <ScrollViewer x:Name="AttachmentScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <ItemsControl x:Name="AttachmentItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AttachmentItem">
                            <Grid Width="96" Height="96">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Image Source="{x:Bind Preview}" Stretch="Uniform" Margin="4" />
                                </Border>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-6,-6,0"
                                        Padding="6,2"
                                        MinWidth="0"
                                        MinHeight="0"
                                        FontSize="11"
                                        Content="×"
                                        Tag="{x:Bind TempPath}"
                                        Click="RemoveAttachment_Click"
                                        ToolTipService.ToolTip="添付を削除" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Row 6: エラー状況 (残りスペースを全て使用) -->
        <TextBox x:Name="DescriptionText" Grid.Row="6"
                 PlaceholderText="エラーの状況を入力してください"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- Row 7: 送信ボタン + プログレス -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="12" Margin="0,4,0,0">
            <ProgressRing x:Name="BusyRing" IsActive="False"
                          Width="24" Height="24" Visibility="Collapsed"
                          VerticalAlignment="Center" />
            <Button x:Name="SubmitButton" Content="エラー報告を送信"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="24,12"
                    Click="SubmitButton_Click" />
        </StackPanel>

    </Grid>
</Window>
