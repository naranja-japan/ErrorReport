{
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "naranja-global",
      "path": "../NaranjaCodeDictionary/global.dic",
      "description": "Naranja 全プロジェクト共通語"
    },
    {
      "name": "naranja-japanese",
      "path": "../NaranjaCodeDictionary/japanese-romaji.dic",
      "description": "日本語ローマ字汎用業務用語"
    },
    {
      "name": "naranja-dotnet",
      "path": "../NaranjaCodeDictionary/dotnet-common.dic",
      "description": ".NET / VB.NET / C# 共通略語"
    },
    {
      "name": "naranja-local",
      "path": "./.config/scanned.dic",
      "description": "プロジェクトスキャンで収集した語（一時置き場）"
    }
  ],
  "dictionaries": [
    "naranja-global",
    "naranja-japanese",
    "naranja-dotnet",
    "naranja-local"
  ],
  "minWordLength": 3,
  "allowCompoundWords": true,
  "ignorePaths": [
    "bin/**",
    "obj/**",
    "**/*.Designer.vb",
    "**/*.Designer.cs",
    "**/*.xsd",
    "**/*.resx",
    "_script/**"
  ],
  "ignoreWords": [
    "tlkcf",
    "qbxkoa",
    "knhm",
    "abcdefghijklmnopqrstuvwxyz"
  ],
  "overrides": [
    {
      "filename": "**/*.vb",
      "ignoreRegExpList": [
        "\\\\b(Sub|End Sub|Function|End Function|Module|Namespace|Imports|Dim|As|Nothing|True|False|AndAlso|OrElse|RaiseEvent|WithEvents|Handles|AddHandler|RemoveHandler|MustOverride|NotOverridable|Overridable|Overrides|Shadows|Shared|Friend|Protected|Private|Public|ReadOnly|WriteOnly|Partial|MustInherit|NotInheritable)\\\\b"
      ]
    }
  ]
}
